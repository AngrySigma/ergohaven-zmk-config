#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC       &kp Q  &kp W  &kp E  &kp R           &kp T                              &kp Y  &kp U     &kp I      &kp O    &kp P     &kp LEFT_CONTROL
&kp TAB       &kp A  &kp S  &kp D  &kp F           &kp G                              &kp H  &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_WIN  &kp Z  &kp X  &kp C  &kp V           &kp B  &kp LBKT     &kp RBKT       &kp N  &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp ENTER
                                   &kp LEFT_SHIFT  &mo 1  &kp SPACE    &kp BACKSPACE  &mo 2  &kp LALT
            >;

            display-name = "Base";
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        math {
            bindings = <
&kp GRAVE  &kp N1    &kp N2                &kp N3                  &kp N4        &kp N5                          &kp N6  &kp N7                 &kp N8             &kp N9           &kp N0            &trans
&trans     &kp EXCL  &kp EQUAL             &kp CARET               &kp STAR      &kp PLUS                        &trans  &kp LEFT_PARENTHESIS   &kp LEFT_BRACKET   &kp LEFT_BRACE   &kp LESS_THAN     &trans
&trans     &trans    &mt LEFT_CONTROL DOT  &mt LEFT_ALT BACKSLASH  &kp KP_SLASH  &kp MINUS  &kp UNDER    &trans  &trans  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp GREATER_THAN  &trans
                                                                   &trans        &trans     &trans       &trans  &mo 3   &trans
            >;

            display-name = "Math";
        };

        nav {
            bindings = <
&trans  &kp LC(LEFT_ARROW)  &kp PAGE_DOWN  &kp PAGE_UP  &kp LC(RIGHT_ARROW)  &trans                          &trans           &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans
&trans  &kp LEFT_ARROW      &kp DOWN       &kp UP       &kp RIGHT_ARROW      &trans                          &kp PRINTSCREEN  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
&trans  &kp LC(Z)           &kp LC(X)      &kp C        &kp C_AC_PASTE       &trans  &kp CAPS    &kp DELETE  &trans           &trans          &mkp MB4      &mkp MB5        &trans           &trans
                                                        &mkp MB2             &mo 3   &mkp MB1    &trans      &trans           &trans
            >;

            display-name = "Navigation";
        };

        adj {
            bindings = <
&bootloader  &kp F1  &kp F2   &kp F3   &kp F4   &trans                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans       &kp F5  &kp F6   &kp F7   &kp F8   &trans                    &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &trans        &studio_unlock
&trans       &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans    &trans  &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &tog 4
                                       &trans   &trans  &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };

        game {
            bindings = <
&kp ESC   &kp T  &kp Q  &kp W  &kp E      &kp R                           &kp Y   &kp U   &kp I   &kp O   &kp P   &trans
&kp TAB   &kp G  &kp A  &kp S  &kp D      &kp F                           &kp H   &kp J   &kp K   &kp L   &trans  &trans
&kp LALT  &kp B  &kp Z  &kp X  &kp C      &kp V      &mo 5        &trans  &kp N   &kp M   &trans  &trans  &trans  &tog 4
                               &kp LCTRL  &kp LSHFT  &kp SPACE    &trans  &trans  &trans
            >;
        };

        game_num {
            display-name = "Game numbers";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
